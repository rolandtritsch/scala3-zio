{
    "files.watcherExclude": {
        "**/target": true
    },
    "makefile.configureOnOpen": false,
    "editor.formatOnSave": true,
    "[scala]": {
        "editor.defaultFormatter": "scalameta.metals"
    },
    "[markdown]": {
        "editor.codeActionsOnSave": {
            "source.fixAll.markdownlint": "explicit"
        }
    },
    "markdownlint.config": {
        "extends": ".markdownlint.jsonc"
    }
}