#!/bin/bash
set -e

echo "Running pre-commit checks..."

# Get the repository root directory
REPO_ROOT=$(git rev-parse --show-toplevel)

# Run markdown checks
"$REPO_ROOT/scripts/pre-commit_check-markdown.sh"

# Run Scala checks
"$REPO_ROOT/scripts/pre-commit_check-scala.sh"

echo "✅ All pre-commit checks passed!"
exit 0
